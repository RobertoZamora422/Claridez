# Entorno local. Copiar como .env y generar valores criptográficamente seguros
# para cada variable secreta vacía. Nunca versionar .env.
CLARIDEZ_ENVIRONMENT=local
CLARIDEZ_SECRET_KEY=
CLARIDEZ_ALLOWED_HOSTS=127.0.0.1,localhost
CLARIDEZ_LOG_LEVEL=INFO
CLARIDEZ_AUTH_LINK_BASE_URL=http://127.0.0.1:5173

# Conexión compartida al PostgreSQL local publicado solo sobre loopback.
CLARIDEZ_DB_HOST=127.0.0.1
CLARIDEZ_DB_PORT=55432
CLARIDEZ_DB_CONNECT_TIMEOUT=3
CLARIDEZ_DB_STATEMENT_TIMEOUT_MS=3000
CLARIDEZ_DB_SSLMODE=disable

# Ejecución normal de Django.
CLARIDEZ_DB_NAME=claridez_local
CLARIDEZ_DB_USER=claridez_app
CLARIDEZ_DB_PASSWORD=

# Migraciones de Django.
CLARIDEZ_MIGRATION_DB_USER=claridez_migrator
CLARIDEZ_MIGRATION_DB_PASSWORD=

# Pruebas de integración. Django crea y destruye claridez_test.
CLARIDEZ_TEST_DB_NAME=claridez_test
CLARIDEZ_TEST_DB_USER=claridez_test_runner
CLARIDEZ_TEST_DB_PASSWORD=

# Bootstrap local explícito. Estas credenciales no se cargan en Django.
CLARIDEZ_POSTGRES_ADMIN_DB=postgres
CLARIDEZ_POSTGRES_ADMIN_USER=postgres
CLARIDEZ_POSTGRES_ADMIN_PASSWORD=

# P9: almacenamiento privado, scanner y entorno canónico de emisión.
CLARIDEZ_DOCUMENT_STORAGE_BACKEND=filesystem
CLARIDEZ_DOCUMENT_STORAGE_ROOT=.runtime/documents
# Para S3/R2/B2 u otro API S3-compatible: usar s3 y completar endpoint/bucket/credenciales.
CLARIDEZ_DOCUMENT_S3_ENDPOINT_URL=
CLARIDEZ_DOCUMENT_S3_REGION=us-east-1
CLARIDEZ_DOCUMENT_S3_BUCKET=
CLARIDEZ_DOCUMENT_S3_ACCESS_KEY_ID=
CLARIDEZ_DOCUMENT_S3_SECRET_ACCESS_KEY=
CLARIDEZ_DOCUMENT_S3_SSE=AES256
CLARIDEZ_DOCUMENT_S3_KMS_KEY_ID=
CLARIDEZ_DOCUMENT_MAX_UPLOAD_BYTES=10485760
CLARIDEZ_DOCUMENT_SCANNER_HOST=127.0.0.1
CLARIDEZ_DOCUMENT_SCANNER_PORT=3310
CLARIDEZ_DOCUMENT_SCANNER_TIMEOUT_SECONDS=20
CLARIDEZ_DOCUMENT_JOB_LEASE_SECONDS=120
CLARIDEZ_DOCUMENT_RENDERER_ENVIRONMENT=host-not-approved
# Opcional localmente: si falta, se deriva con separaciÃ³n de contexto desde SECRET_KEY.
# En un entorno destino debe fijarse una clave dedicada estable de al menos 32 caracteres.
CLARIDEZ_DOCUMENT_TOKEN_HMAC_KEY=
